min-release-age=21

# Exempt 1P Google & Firebase packages from release-age cooldown
min-release-age-exclude[]=firebase
min-release-age-exclude[]=firebase-*
min-release-age-exclude[]=@firebase/*
min-release-age-exclude[]=@apphosting/*
min-release-age-exclude[]=@genkit-ai/*
min-release-age-exclude[]=genkit
min-release-age-exclude[]=@google/*
min-release-age-exclude[]=@google-cloud/*
min-release-age-exclude[]=@googleapis/*
min-release-age-exclude[]=googleapis
min-release-age-exclude[]=googleapis-*
min-release-age-exclude[]=google-*
min-release-age-exclude[]=gaxios
min-release-age-exclude[]=gcp-metadata
min-release-age-exclude[]=gtoken
min-release-age-exclude[]=superstatic

# For 3P security patches (< 21 days old),
# add a `min-release-age-exclude[]=<package-name>` entry below.
