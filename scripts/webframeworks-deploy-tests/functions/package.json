  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5"
  },
  "private": true,
  "overrides": {
    "@fastify/busboy": "^3.2.2",
    "@grpc/grpc-js": "^1.14.5",
    "uuid": "^11.1.1"
  }
}
